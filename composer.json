{
  "name": "skyyware/stage-cms",
  "description": "A CMS for people and agents, built on Stage.",
  "type": "project",
  "license": "MIT",
  "keywords": [
    "cms",
    "php",
    "agents",
    "stage"
  ],
  "require": {
    "php": "^8.4",
    "ext-fileinfo": "*",
    "ext-gd": "*",
    "ext-mbstring": "*",
    "ext-pdo": "*",
    "ext-pdo_sqlite": "*",
    "ext-zip": "*",
    "league/commonmark": "^2.7",
    "skyyware/stage": "^0.1.1"
  },
  "require-dev": {
    "phpstan/phpstan": "^2.1",
    "phpunit/phpunit": "^12.0"
  },
  "autoload": {
    "psr-4": {
      "StageCms\\": "src/"
    }
  },
  "autoload-dev": {
    "psr-4": {
      "StageCms\\Tests\\": "tests/"
    }
  },
  "scripts": {
    "check": [
      "@composer validate --strict",
      "phpstan analyse --no-progress",
      "phpunit"
    ],
    "serve": [
      "Composer\\Config::disableProcessTimeout",
      "@php -d upload_max_filesize=5M -d post_max_size=8M -S 127.0.0.1:8088 -t public public/router.php"
    ]
  },
  "config": {
    "sort-packages": true,
    "allow-plugins": false
  }
}
